# MongoDB
MONGODB_URL=mongodb://localhost:27017

# KYC Provider (issuer wallet) — for signing credentials and sending register tx
KYC_PROVIDER_PRIVATE_KEY=0x...   # 64 hex chars; use scripts/generate_kyc_key.py to generate
# Optional: for logging / verification
# KYC_PROVIDER_ADDRESS=0x...

# Use Case 6: Register credential hash on-chain (DecentralizedKYCCredentialRegistry)
# Set these after deploying smart-contract/src/dKYCRegistry.sol:
RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
CONTRACT_ADDRESS=0x...   # Deployed DecentralizedKYCCredentialRegistry address

# After deploy: contract admin must call addIssuer(KYC_PROVIDER_ADDRESS) so the
# backend wallet can register credentials (onlyIssuer modifier).

# Alternative env names (same behaviour if above are not set):
# ETH_RPC_URL=...
# DKYC_REGISTRY_CONTRACT_ADDRESS=...
